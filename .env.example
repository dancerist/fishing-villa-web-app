# WooCommerce Configuration
# Copy this file to .env and fill in your values

# WooCommerce Store URL (your WordPress site URL)
WC_API_URL=https://your-wordpress-site.com/wp-json

# WooCommerce REST API Credentials
# Generate these in WordPress: WooCommerce > Settings > Advanced > REST API
WC_CONSUMER_KEY=ck_your_consumer_key
WC_CONSUMER_SECRET=cs_your_consumer_secret

# WooCommerce Access Secret (for secure client-side requests)
WC_ACCESS_SECRET=your_random_secret_string

# JWT Secret for authentication
JWT_SECRET=your_jwt_secret_32_chars_minimum

# Stripe (optional - for Stripe payments)
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# PayPal (optional - for PayPal payments)
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox

# Store currency (used for PayPal SDK, defaults to USD)
PUBLIC_STORE_CURRENCY=USD

# Site URL (for callbacks and sitemap)
PUBLIC_SITE_URL=https://your-site.com

# Cloudflare Turnstile (optional - bot protection for checkout and reviews)
# Get keys at https://dash.cloudflare.com/?to=/:account/turnstile
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
