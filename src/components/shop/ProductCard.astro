---
/**
 * Product Card Component
 * 
 * Displays a product in a grid format with image, name, price, and add-to-cart
 * Uses Astro Image component with locally downloaded images for optimization
 */

import { Image } from 'astro:assets';
import { getLocalProductImageUrl, getPublicProductImageUrl } from '../../lib/product-media';

interface Props {
    product: {
        id: number;
        name: string;
        slug: string;
        price: string;
        regular_price: string;
        sale_price: string;
        on_sale: boolean;
        stock_status: string;
        purchasable: boolean;
        is_in_stock?: boolean;
        is_on_backorder?: boolean;
        low_stock_remaining?: number | null;
        images: Array<{ src: string; alt: string; thumbnail?: string }>;
        average_rating: string;
        rating_count: number;
        date_created: string;
        attributes?: Array<{ name: string; options: string[]; visible: boolean }>;
    };
}

const { product } = Astro.props;

import { formatPrice, isInStock, getDiscountPercentage } from '../../lib/woocommerce';

const mainImage = product.images?.[0];
const originalUrl = mainImage?.src || mainImage?.thumbnail || '';
const imageUrl = getLocalProductImageUrl(originalUrl);
const isLocalImage = imageUrl && imageUrl.startsWith('/src/media/');
const hasValidImage = imageUrl && (imageUrl.startsWith('/src/media/') || imageUrl.startsWith('http://') || imageUrl.startsWith('https://'));
const inStock = (product.is_in_stock !== false) && (product.stock_status === 'instock') && product.purchasable;
const discount = product.on_sale && product.regular_price && product.sale_price
    ? Math.round(((parseFloat(product.regular_price) - parseFloat(product.sale_price)) / parseFloat(product.regular_price)) * 100)
    : null;

// For local images, we need to dynamically import them for Astro's Image component
// We'll use a glob pattern to import all product images
const productImages = import.meta.glob('/src/media/products/*', { eager: true });
const localImageModule = isLocalImage && productImages[imageUrl];
const localImageSrc = localImageModule?.default;

// For cart, use optimized WebP from public folder
const cartImageUrl = getPublicProductImageUrl(originalUrl) || originalUrl;
const attributesJson = JSON.stringify((product.attributes || []).reduce((acc, attr) => { acc[attr.name.toLowerCase().replace(/\s+/g, '-')] = (attr.terms || []).map(t => t.name); return acc; }, {} as Record<string, string[]>));
---

<article 
    class="group bg-surface rounded-2xl border border-outline overflow-hidden hover:shadow-lg hover:border-primary-light transition-all duration-300"
    data-product-card
    data-product-id={product.id}
    data-price={product.price}
    data-name={product.name}
    data-on-sale={product.on_sale}
    data-in-stock={inStock}
    data-date={product.date_created}
    data-attributes={attributesJson}
>
    <a href={`/shop/product/${product.slug}`} class="block cursor-pointer">
        <!-- Image with Astro optimization -->
        <div class="relative aspect-square overflow-hidden bg-surface-alt">
            {localImageSrc ? (
                <Image 
                    src={localImageSrc}
                    alt={mainImage?.alt || product.name}
                    width={400}
                    height={400}
                    format="webp"
                    quality={80}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                    loading="lazy"
                />
            ) : hasValidImage ? (
                <img 
                    src={imageUrl} 
                    alt={mainImage?.alt || product.name}
                    width="400"
                    height="400"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                    loading="lazy"
                    decoding="async"
                />
            ) : (
                <div class="w-full h-full flex items-center justify-center">
                    <svg class="w-16 h-16 text-content-lighter" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                    </svg>
                </div>
            )}
            
            <!-- Badges -->
            <div class="absolute top-3 left-3 flex flex-col gap-2 z-10">
                {discount && (
                    <span class="px-2 py-1 bg-error text-white text-xs font-semibold rounded">
                        -{discount}%
                    </span>
                )}
                {!inStock && (
                    <span class="px-2 py-1 bg-content text-white text-xs font-semibold rounded">
                        Out of Stock
                    </span>
                )}
                {inStock && product.is_on_backorder && (
                    <span class="px-2 py-1 bg-warning text-white text-xs font-semibold rounded">
                        Backorder
                    </span>
                )}
                {inStock && !product.is_on_backorder && product.low_stock_remaining != null && (
                    <span class="px-2 py-1 bg-warning text-white text-xs font-semibold rounded">
                        Only {product.low_stock_remaining} left
                    </span>
                )}
            </div>
            
            <!-- Quick View Overlay -->
            <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center z-10">
                <span class="bg-white text-content px-4 py-2 rounded-lg font-medium text-sm">
                    View Details
                </span>
            </div>
        </div>
    </a>
    
    <!-- Content -->
    <div class="p-4">
        <!-- Rating -->
        {product.average_rating && parseFloat(product.average_rating) > 0 && (
            <div class="flex items-center gap-1 mb-2">
                {[1, 2, 3, 4, 5].map(star => (
                    <svg 
                        class={`w-4 h-4 ${star <= Math.round(parseFloat(product.average_rating)) ? 'text-warning' : 'text-outline'}`}
                        fill="currentColor" 
                        viewBox="0 0 20 20"
                    >
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
                    </svg>
                ))}
                <span class="text-xs text-content-lighter ml-1">({product.rating_count})</span>
            </div>
        )}
        
        <!-- Name -->
        <a href={`/shop/product/${product.slug}`} class="cursor-pointer">
            <h3 class="font-semibold text-content group-hover:text-primary transition-colors line-clamp-2 mb-2">
                {product.name}
            </h3>
        </a>
        
        <!-- Price -->
        <div class="flex items-baseline gap-2 mb-4">
            <span class="text-lg font-bold text-content">
                {formatPrice(product.price)}
            </span>
            {product.on_sale && product.regular_price && (
                <span class="text-sm text-content-lighter line-through">
                    {formatPrice(product.regular_price)}
                </span>
            )}
        </div>
        
        <!-- Add to Cart Button -->
        <button 
            class={`w-full py-2.5 rounded-lg font-medium text-sm transition-colors cursor-pointer ${
                inStock 
                    ? 'bg-primary text-white hover:bg-primary-dark' 
                    : 'bg-surface-alt text-content-lighter cursor-not-allowed'
            }`}
            data-add-to-cart
            data-product-id={product.id}
            data-product-name={product.name}
            data-product-price={product.price}
            data-product-image={cartImageUrl}
            disabled={!inStock}
        >
            {inStock ? 'Add to Cart' : 'Out of Stock'}
        </button>
    </div>
</article>

<script>
    // Add to cart functionality is handled globally
    document.querySelectorAll('[data-add-to-cart]').forEach(btn => {
        btn.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            
            const button = e.currentTarget as HTMLButtonElement;
            const productId = parseInt(button.dataset.productId || '0');
            const name = button.dataset.productName || '';
            const price = parseFloat(button.dataset.productPrice || '0');
            const image = button.dataset.productImage || '';
            
            // Import and use cart store
            import('../../lib/cart').then(({ addToCart, openCartDrawer }) => {
                addToCart({
                    id: productId,  // Use 'id' to match CartItem interface
                    name,
                    price,
                    quantity: 1,
                    image,
                });
                openCartDrawer();
            });
        });
    });
</script>
