---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Section from '../components/Section.astro';
import Mail from '@lucide/astro/icons/mail';

export const prerender = true;

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '';
---

<BaseLayout title="Forgot Password">
    <Header />
    <main id="main-content">
        <div class="relative overflow-hidden bg-gradient-to-br from-primary/5 via-surface to-primary-light/10 min-h-[calc(100vh-5rem)]">
            <div class="absolute inset-0 bg-[linear-gradient(to_right,var(--color-outline)_1px,transparent_1px),linear-gradient(to_bottom,var(--color-outline)_1px,transparent_1px)] bg-[size:4rem_4rem] opacity-30"></div>
            <Section padding="lg" class="relative z-10">
                <div class="max-w-md mx-auto">
                    <div class="text-center mb-8">
                        <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-primary/10 mb-4">
                            <Mail class="w-8 h-8 text-primary" />
                        </div>
                        <h1 class="text-3xl sm:text-4xl font-black tracking-tight text-content mb-2">Forgot Password</h1>
                        <p class="text-content-light">Enter your email and we will send you a link to reset your password.</p>
                    </div>

                    <div class="bg-surface rounded-2xl border border-outline p-8 shadow-xl shadow-black/5">
                        <!-- Request Form -->
                        <form id="forgot-form" class="space-y-5">
                            <div>
                                <label for="email" class="block text-sm font-medium text-content mb-2">
                                    Email Address
                                </label>
                                <input
                                    type="email"
                                    id="email"
                                    name="email"
                                    required
                                    class="w-full px-4 py-3 border border-outline rounded-xl focus:ring-2 focus:ring-primary focus:border-primary text-content bg-surface transition-colors"
                                    placeholder="your@email.com"
                                />
                            </div>

                            {turnstileSiteKey && (
                                <div id="turnstile-container" data-turnstile-site-key={turnstileSiteKey}></div>
                            )}

                            <div id="forgot-error" class="hidden p-4 bg-error/10 text-error rounded-xl text-sm">
                                <p id="error-message"></p>
                            </div>

                            <button
                                type="submit"
                                id="submit-btn"
                                class="w-full bg-gradient-to-r from-primary to-primary-dark text-white px-6 py-3.5 rounded-xl font-semibold hover:shadow-lg hover:shadow-primary/25 transition-all cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
                            >
                                <span id="btn-text">Send Reset Link</span>
                                <span id="btn-loading" class="hidden">
                                    <svg class="animate-spin h-5 w-5 mx-auto" fill="none" viewBox="0 0 24 24">
                                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                    </svg>
                                </span>
                            </button>
                        </form>

                        <!-- Success State -->
                        <div id="success-state" class="hidden text-center py-4">
                            <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-success/10 mb-4">
                                <svg class="w-7 h-7 text-success" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                                </svg>
                            </div>
                            <h2 class="text-xl font-bold text-content mb-2">Check your email</h2>
                            <p class="text-content-light text-sm mb-6">
                                If an account exists with that email, we have sent a password reset link. Check your inbox and spam folder.
                            </p>
                            <button
                                id="try-again-btn"
                                class="text-sm text-primary hover:text-primary-dark font-medium cursor-pointer transition-colors"
                            >
                                Try a different email
                            </button>
                        </div>

                        <p class="text-center text-content-light mt-6 text-sm">
                            Remember your password?{' '}
                            <a href="/login" class="text-primary hover:text-primary-dark font-semibold cursor-pointer">
                                Sign in
                            </a>
                        </p>
                    </div>
                </div>
            </Section>
        </div>
    </main>
    <Footer />
</BaseLayout>

<script>
    // Turnstile setup
    let turnstileToken = '';
    const turnstileContainer = document.getElementById('turnstile-container');
    const turnstileSiteKey = turnstileContainer?.dataset.turnstileSiteKey;
    if (turnstileSiteKey && turnstileContainer) {
        const script = document.createElement('script');
        script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?onload=onTurnstileLoad';
        script.async = true;
        (window as any).onTurnstileLoad = () => {
            (window as any).turnstile.render(turnstileContainer, {
                sitekey: turnstileSiteKey,
                callback: (token: string) => { turnstileToken = token; },
                'expired-callback': () => { turnstileToken = ''; },
                'error-callback': () => { turnstileToken = ''; },
                theme: 'auto',
            });
        };
        document.head.appendChild(script);
    }

    const form = document.getElementById('forgot-form') as HTMLFormElement;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
    const btnText = document.getElementById('btn-text');
    const btnLoading = document.getElementById('btn-loading');
    const forgotError = document.getElementById('forgot-error');
    const errorMessage = document.getElementById('error-message');
    const successState = document.getElementById('success-state');
    const tryAgainBtn = document.getElementById('try-again-btn');

    function showError(message: string) {
        if (forgotError && errorMessage) {
            errorMessage.textContent = message;
            forgotError.classList.remove('hidden');
        }
    }

    function hideError() {
        forgotError?.classList.add('hidden');
    }

    function setLoading(loading: boolean) {
        if (submitBtn) submitBtn.disabled = loading;
        btnText?.classList.toggle('hidden', loading);
        btnLoading?.classList.toggle('hidden', !loading);
    }

    form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        hideError();

        if (turnstileSiteKey && !turnstileToken) {
            showError('Please complete the security verification.');
            return;
        }

        setLoading(true);

        const email = (document.getElementById('email') as HTMLInputElement)?.value;

        try {
            const response = await fetch('/api/auth/forgot-password', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email, ...(turnstileToken ? { turnstile_token: turnstileToken } : {}) }),
            });

            const data = await response.json();

            if (!response.ok || !data.success) {
                showError(data.error || 'Something went wrong. Please try again.');
                setLoading(false);
                if (turnstileSiteKey && (window as any).turnstile) {
                    turnstileToken = '';
                    (window as any).turnstile.reset(turnstileContainer);
                }
                return;
            }

            // Show success state
            form.classList.add('hidden');
            successState?.classList.remove('hidden');
        } catch {
            showError('Network error. Please try again.');
            setLoading(false);
            if (turnstileSiteKey && (window as any).turnstile) {
                turnstileToken = '';
                (window as any).turnstile.reset(turnstileContainer);
            }
        }
    });

    tryAgainBtn?.addEventListener('click', () => {
        form?.classList.remove('hidden');
        successState?.classList.add('hidden');
        setLoading(false);
        if (turnstileSiteKey && (window as any).turnstile) {
            turnstileToken = '';
            (window as any).turnstile.reset(turnstileContainer);
        }
    });
</script>
