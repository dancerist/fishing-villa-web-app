---
import { getLocalProducts, getLocalCategories, getLocalFeaturedProducts } from '../lib/local-product-data';
import { formatPrice, isInStock } from '../lib/woocommerce';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Section from '../components/Section.astro';
import ProductCard from '../components/shop/ProductCard.astro';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Truck from '@lucide/astro/icons/truck';
import ShieldCheck from '@lucide/astro/icons/shield-check';
import CreditCard from '@lucide/astro/icons/credit-card';
import Headphones from '@lucide/astro/icons/headphones';

export const prerender = true;

const allProducts = await getLocalProducts();
const featuredProducts = await getLocalFeaturedProducts(4);
const recentProducts = allProducts.slice(0, 8);
const categories = await getLocalCategories();
const topCategories = categories.filter(c => c.parent === 0 && c.count > 0).slice(0, 6);
---

<BaseLayout title="Shop">
    <Header />
    <main id="main-content">
        <!-- Hero -->
        <div class="relative overflow-hidden bg-gradient-to-br from-primary/5 via-surface to-primary-light/10">
            <div class="absolute inset-0 bg-[linear-gradient(to_right,var(--color-outline)_1px,transparent_1px),linear-gradient(to_bottom,var(--color-outline)_1px,transparent_1px)] bg-[size:4rem_4rem] opacity-30"></div>
            <div class="absolute top-20 right-10 w-72 h-72 bg-primary/10 rounded-full blur-[100px]"></div>
            <div class="absolute bottom-10 left-10 w-96 h-96 bg-primary-light/10 rounded-full blur-[100px]"></div>
            <Section padding="lg" class="relative z-10">
                <div class="text-center max-w-4xl mx-auto py-8 md:py-16">
                    <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-primary/10 text-primary text-sm font-medium mb-8 tracking-wide">
                        <span class="w-1.5 h-1.5 bg-primary rounded-full animate-ping"></span>
                        Welcome to Shop
                    </span>
                    <h1 class="text-5xl sm:text-6xl md:text-7xl font-black tracking-tight text-content mb-6 leading-tight">
                        Discover Our
                        <span class="bg-gradient-to-r from-primary to-primary-dark bg-clip-text text-transparent"> Collection</span>
                    </h1>
                    <p class="text-lg md:text-xl text-content-light max-w-2xl mx-auto mb-10 leading-relaxed">
                        Browse our curated selection of products. Quality items, great prices, and fast shipping.
                    </p>
                    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
                        <a href="/shop" class="group inline-flex items-center gap-2 bg-gradient-to-r from-primary to-primary-dark text-white px-8 py-4 rounded-xl font-semibold hover:shadow-xl hover:shadow-primary/25 hover:-translate-y-0.5 transition-all duration-300 cursor-pointer">
                            Shop Now
                            <ArrowRight class="w-5 h-5 group-hover:translate-x-1 transition-transform" />
                        </a>
                        {topCategories.length > 0 && (
                            <a href="#categories" class="inline-flex items-center gap-2 px-8 py-4 rounded-xl font-semibold border border-outline text-content hover:border-primary hover:text-primary transition-all duration-300 cursor-pointer">
                                Browse Categories
                            </a>
                        )}
                    </div>
                </div>
            </Section>
        </div>

        <!-- Featured Products -->
        {featuredProducts.length > 0 && (
            <Section padding="lg">
                <div class="flex items-end justify-between mb-12">
                    <div>
                        <span class="text-sm font-semibold text-primary tracking-wide uppercase">Featured</span>
                        <h2 class="text-3xl sm:text-4xl font-black tracking-tight text-content mt-2">Top Picks</h2>
                    </div>
                    <a href="/shop" class="group hidden sm:inline-flex items-center gap-2 text-primary font-medium hover:gap-3 transition-all cursor-pointer">
                        View all
                        <ArrowRight class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
                    </a>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8">
                    {featuredProducts.map(product => (
                        <ProductCard product={product} />
                    ))}
                </div>
                <div class="sm:hidden mt-8 text-center">
                    <a href="/shop" class="inline-flex items-center gap-2 text-primary font-medium cursor-pointer">
                        View all products
                        <ArrowRight class="w-4 h-4" />
                    </a>
                </div>
            </Section>
        )}

        <!-- Categories -->
        {topCategories.length > 0 && (
            <Section bg="surface-alt" padding="lg" id="categories">
                <div class="text-center mb-12">
                    <span class="text-sm font-semibold text-primary tracking-wide uppercase">Categories</span>
                    <h2 class="text-3xl sm:text-4xl font-black tracking-tight text-content mt-2">Shop by Category</h2>
                </div>
                <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4 lg:gap-6">
                    {topCategories.map(category => (
                        <a
                            href={`/shop/category/${category.slug}`}
                            class="group relative bg-surface rounded-2xl border border-outline p-6 text-center hover:border-primary hover:shadow-lg hover:-translate-y-1 transition-all duration-300 cursor-pointer overflow-hidden"
                        >
                            <div class="absolute inset-0 bg-gradient-to-br from-primary/0 to-primary/5 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                            <div class="relative z-10">
                                {category.image?.src ? (
                                    <img
                                        src={category.image.src}
                                        alt={category.name}
                                        class="w-16 h-16 mx-auto mb-4 rounded-xl object-cover"
                                    />
                                ) : (
                                    <div class="w-16 h-16 mx-auto mb-4 rounded-xl bg-primary/10 flex items-center justify-center">
                                        <svg class="w-8 h-8 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path>
                                        </svg>
                                    </div>
                                )}
                                <h3 class="font-semibold text-content group-hover:text-primary transition-colors text-sm">{category.name}</h3>
                                <p class="text-xs text-content-lighter mt-1">{category.count} products</p>
                            </div>
                        </a>
                    ))}
                </div>
            </Section>
        )}

        <!-- Recent Products -->
        {recentProducts.length > 0 && (
            <Section padding="lg">
                <div class="flex items-end justify-between mb-12">
                    <div>
                        <span class="text-sm font-semibold text-primary tracking-wide uppercase">New Arrivals</span>
                        <h2 class="text-3xl sm:text-4xl font-black tracking-tight text-content mt-2">Latest Products</h2>
                    </div>
                    <a href="/shop" class="group hidden sm:inline-flex items-center gap-2 text-primary font-medium hover:gap-3 transition-all cursor-pointer">
                        View all
                        <ArrowRight class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
                    </a>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8">
                    {recentProducts.map(product => (
                        <ProductCard product={product} />
                    ))}
                </div>
            </Section>
        )}

        <!-- Trust Badges -->
        <Section bg="surface-alt" padding="md">
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8">
                <div class="flex items-center gap-4 p-6 bg-surface rounded-2xl border border-outline">
                    <div class="flex-shrink-0 w-12 h-12 bg-primary/10 rounded-xl flex items-center justify-center">
                        <Truck class="w-6 h-6 text-primary" />
                    </div>
                    <div>
                        <h3 class="font-semibold text-content text-sm">Free Shipping</h3>
                        <p class="text-xs text-content-lighter">On orders over $50</p>
                    </div>
                </div>
                <div class="flex items-center gap-4 p-6 bg-surface rounded-2xl border border-outline">
                    <div class="flex-shrink-0 w-12 h-12 bg-primary/10 rounded-xl flex items-center justify-center">
                        <ShieldCheck class="w-6 h-6 text-primary" />
                    </div>
                    <div>
                        <h3 class="font-semibold text-content text-sm">Secure Payment</h3>
                        <p class="text-xs text-content-lighter">SSL encrypted checkout</p>
                    </div>
                </div>
                <div class="flex items-center gap-4 p-6 bg-surface rounded-2xl border border-outline">
                    <div class="flex-shrink-0 w-12 h-12 bg-primary/10 rounded-xl flex items-center justify-center">
                        <CreditCard class="w-6 h-6 text-primary" />
                    </div>
                    <div>
                        <h3 class="font-semibold text-content text-sm">Easy Returns</h3>
                        <p class="text-xs text-content-lighter">30-day return policy</p>
                    </div>
                </div>
                <div class="flex items-center gap-4 p-6 bg-surface rounded-2xl border border-outline">
                    <div class="flex-shrink-0 w-12 h-12 bg-primary/10 rounded-xl flex items-center justify-center">
                        <Headphones class="w-6 h-6 text-primary" />
                    </div>
                    <div>
                        <h3 class="font-semibold text-content text-sm">24/7 Support</h3>
                        <p class="text-xs text-content-lighter">Dedicated customer care</p>
                    </div>
                </div>
            </div>
        </Section>

        <!-- CTA -->
        <div class="relative overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-br from-primary via-primary-dark to-primary"></div>
            <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(255,255,255,0.05)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.05)_1px,transparent_1px)] bg-[size:4rem_4rem]"></div>
            <Section padding="lg" class="relative z-10 text-center text-white">
                <h2 class="text-3xl sm:text-4xl font-black tracking-tight mb-4">Ready to Get Started?</h2>
                <p class="text-lg text-white/80 max-w-xl mx-auto mb-8">Join thousands of happy customers and find exactly what you're looking for.</p>
                <a href="/shop" class="group inline-flex items-center gap-2 bg-white text-primary px-8 py-4 rounded-xl font-semibold hover:shadow-xl hover:-translate-y-0.5 transition-all duration-300 cursor-pointer">
                    Browse Products
                    <ArrowRight class="w-5 h-5 group-hover:translate-x-1 transition-transform" />
                </a>
            </Section>
        </div>
    </main>
    <Footer />
</BaseLayout>
