---
import { getLocalProducts, getLocalVisibleCategories } from '../../lib/local-product-data';
import { formatPrice, isInStock } from '../../lib/woocommerce';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Section from '../../components/Section.astro';
import ProductCard from '../../components/shop/ProductCard.astro';
import ArrowRight from '@lucide/astro/icons/arrow-right';

export const prerender = true;

const products = await getLocalProducts();
const visibleCategories = await getLocalVisibleCategories();

// Collect all attributes across all products for filter UI
const attributeMap = new Map<string, Set<string>>();
products.forEach(p => {
    (p.attributes || []).forEach((attr: any) => {
        const key = attr.name;
        if (!attributeMap.has(key)) attributeMap.set(key, new Set());
        (attr.terms || []).forEach((term: any) => attributeMap.get(key)!.add(term.name));
    });
});
const filterAttributes = Array.from(attributeMap.entries()).map(([name, values]) => ({
    name,
    slug: name.toLowerCase().replace(/\s+/g, '-'),
    values: Array.from(values).sort(),
}));
---

<BaseLayout title="Shop" description="Browse our product collection">
    <Header />
    <main id="main-content">
        <!-- Hero -->
        <div class="relative overflow-hidden bg-gradient-to-br from-primary/5 via-surface to-primary-light/10">
            <div class="absolute inset-0 bg-[linear-gradient(to_right,var(--color-outline)_1px,transparent_1px),linear-gradient(to_bottom,var(--color-outline)_1px,transparent_1px)] bg-[size:4rem_4rem] opacity-30"></div>
            <Section padding="md" class="relative z-10">
                <div class="text-center max-w-3xl mx-auto">
                    <h1 class="text-4xl sm:text-5xl md:text-6xl font-black tracking-tight text-content mb-4">
                        Shop
                    </h1>
                    <p class="text-lg text-content-light max-w-xl mx-auto">
                        Discover our collection of quality products
                    </p>
                </div>
            </Section>
        </div>
        
        <!-- Filters & Products -->
        <Section padding="lg" bg="surface-alt">
            <div class="flex flex-col lg:flex-row gap-8">
                <!-- Sidebar Filters -->
                <aside class="lg:w-64 flex-shrink-0">
                    <div class="bg-surface rounded-2xl border border-outline p-6 sticky top-24">
                        <h2 class="text-sm font-semibold text-primary tracking-wide uppercase mb-4">Categories</h2>
                        <ul class="space-y-1">
                            <li>
                                <a 
                                    href="/shop" 
                                    class="flex items-center justify-between px-3 py-2.5 rounded-xl text-content bg-primary/5 font-medium transition-colors cursor-pointer"
                                    data-category="all"
                                >
                                    <span>All Products</span>
                                    <span class="text-xs bg-primary/10 text-primary px-2 py-0.5 rounded-full">{products.length}</span>
                                </a>
                            </li>
                            {visibleCategories.map(category => (
                                <li>
                                    <a 
                                        href={`/shop/category/${category.slug}`}
                                        class="flex items-center justify-between px-3 py-2.5 rounded-xl text-content hover:bg-surface-alt transition-colors cursor-pointer"
                                        data-category={category.slug}
                                    >
                                        <span>{category.name}</span>
                                        <span class="text-xs text-content-lighter">{category.count}</span>
                                    </a>
                                </li>
                            ))}
                        </ul>
                        
                        <hr class="my-6 border-outline" />
                        
                        <h2 class="text-sm font-semibold text-primary tracking-wide uppercase mb-4">Filter</h2>
                        <div class="space-y-3">
                            <label class="flex items-center gap-3 cursor-pointer group">
                                <input 
                                    type="checkbox" 
                                    id="filter-sale" 
                                    class="w-4 h-4 text-primary rounded border-outline focus:ring-primary cursor-pointer"
                                />
                                <span class="text-content group-hover:text-primary transition-colors">On Sale</span>
                            </label>
                            <label class="flex items-center gap-3 cursor-pointer group">
                                <input 
                                    type="checkbox" 
                                    id="filter-stock" 
                                    class="w-4 h-4 text-primary rounded border-outline focus:ring-primary cursor-pointer"
                                />
                                <span class="text-content group-hover:text-primary transition-colors">In Stock Only</span>
                            </label>
                        </div>
                        
                        <hr class="my-6 border-outline" />
                        
                        <h2 class="text-sm font-semibold text-primary tracking-wide uppercase mb-4">Price Range</h2>
                        <div class="flex items-center gap-2">
                            <input 
                                type="number" 
                                id="filter-min-price" 
                                placeholder="Min"
                                min="0"
                                step="any"
                                class="w-full px-3 py-2 bg-surface-alt border border-outline rounded-lg text-sm text-content focus:ring-2 focus:ring-primary focus:border-primary"
                            />
                            <span class="text-content-lighter">-</span>
                            <input 
                                type="number" 
                                id="filter-max-price" 
                                placeholder="Max"
                                min="0"
                                step="any"
                                class="w-full px-3 py-2 bg-surface-alt border border-outline rounded-lg text-sm text-content focus:ring-2 focus:ring-primary focus:border-primary"
                            />
                        </div>
                        <button 
                            id="apply-price-filter"
                            class="mt-2 w-full py-2 bg-primary/10 text-primary rounded-lg text-sm font-medium hover:bg-primary/20 transition-colors cursor-pointer"
                        >
                            Apply Price
                        </button>
                        
                        {filterAttributes.length > 0 && (
                            <>
                                <hr class="my-6 border-outline" />
                                <h2 class="text-sm font-semibold text-primary tracking-wide uppercase mb-4">Attributes</h2>
                                {filterAttributes.map(attr => (
                                    <div class="mb-4" data-attr-filter={attr.slug}>
                                        <button 
                                            class="flex items-center justify-between w-full text-sm font-medium text-content mb-2 cursor-pointer"
                                            data-attr-toggle={attr.slug}
                                        >
                                            <span>{attr.name}</span>
                                            <svg class="w-4 h-4 transition-transform" data-attr-chevron={attr.slug} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                                            </svg>
                                        </button>
                                        <div class="space-y-1.5 hidden" data-attr-options={attr.slug}>
                                            {attr.values.map(val => (
                                                <label class="flex items-center gap-2 cursor-pointer group text-sm">
                                                    <input 
                                                        type="checkbox" 
                                                        class="w-3.5 h-3.5 text-primary rounded border-outline focus:ring-primary cursor-pointer"
                                                        data-attr-checkbox={attr.slug}
                                                        value={val}
                                                    />
                                                    <span class="text-content-light group-hover:text-content transition-colors">{val}</span>
                                                </label>
                                            ))}
                                        </div>
                                    </div>
                                ))}
                            </>
                        )}
                    </div>
                </aside>
                
                <!-- Product Grid -->
                <div class="flex-1">
                    <!-- Active Filters -->
                    <div id="active-filters" class="hidden flex flex-wrap gap-2 mb-4">
                    </div>
                    
                    <!-- Sort Controls -->
                    <div class="flex items-center justify-between mb-8 bg-surface rounded-xl border border-outline px-6 py-4">
                        <p class="text-content-light text-sm">
                            <span id="product-count-range"></span>Showing <span id="product-count" class="font-semibold text-content">{products.length}</span> products
                        </p>
                        <select 
                            id="sort-select"
                            class="px-4 py-2 bg-surface-alt border border-outline rounded-lg text-sm text-content focus:ring-2 focus:ring-primary focus:border-primary cursor-pointer"
                        >
                            <option value="date-desc">Newest</option>
                            <option value="date-asc">Oldest</option>
                            <option value="price-asc">Price: Low to High</option>
                            <option value="price-desc">Price: High to Low</option>
                            <option value="name-asc">Name: A to Z</option>
                            <option value="name-desc">Name: Z to A</option>
                        </select>
                    </div>
                    
                    {products.length > 0 ? (
                        <div id="product-grid" class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-6">
                            {products.map(product => (
                                <ProductCard product={product} />
                            ))}
                        </div>
                    ) : (
                        <div class="text-center py-24 bg-surface rounded-2xl border border-outline">
                            <div class="inline-flex items-center justify-center w-20 h-20 rounded-2xl bg-primary/10 mb-6">
                                <svg class="w-10 h-10 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
                                </svg>
                            </div>
                            <h2 class="text-2xl font-bold text-content mb-2">No products found</h2>
                            <p class="text-content-lighter">Check back soon for new arrivals!</p>
                        </div>
                    )}
                    
                    <!-- Pagination -->
                    <div id="pagination-controls" class="hidden mt-8 flex items-center justify-center gap-2">
                        <button id="page-prev" class="px-4 py-2 border border-outline rounded-lg text-sm font-medium text-content hover:bg-surface-alt transition-colors cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed">
                            Previous
                        </button>
                        <div id="page-numbers" class="flex items-center gap-1"></div>
                        <button id="page-next" class="px-4 py-2 border border-outline rounded-lg text-sm font-medium text-content hover:bg-surface-alt transition-colors cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed">
                            Next
                        </button>
                    </div>
                </div>
            </div>
        </Section>
    </main>
    <Footer />
</BaseLayout>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const PRODUCTS_PER_PAGE = 24;
        const grid = document.getElementById('product-grid');
        const productCount = document.getElementById('product-count');
        const productCountRange = document.getElementById('product-count-range');
        const sortSelect = document.getElementById('sort-select') as HTMLSelectElement;
        const filterSale = document.getElementById('filter-sale') as HTMLInputElement;
        const filterStock = document.getElementById('filter-stock') as HTMLInputElement;
        const paginationControls = document.getElementById('pagination-controls');
        const pagePrev = document.getElementById('page-prev') as HTMLButtonElement;
        const pageNext = document.getElementById('page-next') as HTMLButtonElement;
        const pageNumbers = document.getElementById('page-numbers');
        
        if (!grid) return;
        
        const allCards = Array.from(grid.querySelectorAll('[data-product-card]'));
        let currentPage = 1;
        const filterMinPrice = document.getElementById('filter-min-price') as HTMLInputElement;
        const filterMaxPrice = document.getElementById('filter-max-price') as HTMLInputElement;
        const applyPriceFilter = document.getElementById('apply-price-filter');
        const activeFiltersContainer = document.getElementById('active-filters');
        
        function getFilteredCards() {
            const showSaleOnly = filterSale?.checked || false;
            const showStockOnly = filterStock?.checked || false;
            const minPrice = filterMinPrice?.value ? parseFloat(filterMinPrice.value) : null;
            const maxPrice = filterMaxPrice?.value ? parseFloat(filterMaxPrice.value) : null;
            
            const attrFilters: Record<string, string[]> = {};
            document.querySelectorAll('[data-attr-checkbox]:checked').forEach(cb => {
                const el = cb as HTMLInputElement;
                const slug = el.dataset.attrCheckbox || '';
                if (!attrFilters[slug]) attrFilters[slug] = [];
                attrFilters[slug].push(el.value);
            });
            
            return allCards.filter(card => {
                const el = card as HTMLElement;
                if (showSaleOnly && el.dataset.onSale !== 'true') return false;
                if (showStockOnly && el.dataset.inStock !== 'true') return false;
                
                const price = parseFloat(el.dataset.price || '0');
                if (minPrice !== null && price < minPrice) return false;
                if (maxPrice !== null && price > maxPrice) return false;
                
                const cardAttrs = JSON.parse(el.dataset.attributes || '{}');
                for (const [slug, values] of Object.entries(attrFilters)) {
                    const cardValues: string[] = cardAttrs[slug] || [];
                    if (!values.some(v => cardValues.includes(v))) return false;
                }
                
                return true;
            });
        }
        
        function renderActiveFilters() {
            if (!activeFiltersContainer) return;
            let chips = '';
            
            if (filterMinPrice?.value || filterMaxPrice?.value) {
                const min = filterMinPrice?.value || '0';
                const max = filterMaxPrice?.value || 'Any';
                chips += `<button data-clear-price class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-primary/10 text-primary rounded-full text-xs font-medium hover:bg-primary/20 transition-colors cursor-pointer">Price: $${min}-$${max} <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg></button>`;
            }
            
            document.querySelectorAll('[data-attr-checkbox]:checked').forEach(cb => {
                const el = cb as HTMLInputElement;
                const slug = el.dataset.attrCheckbox || '';
                const filterDiv = document.querySelector(`[data-attr-filter="${slug}"]`);
                const name = filterDiv?.querySelector('[data-attr-toggle] span')?.textContent || slug;
                chips += `<button data-clear-attr="${slug}" data-clear-value="${el.value}" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-primary/10 text-primary rounded-full text-xs font-medium hover:bg-primary/20 transition-colors cursor-pointer">${name}: ${el.value} <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg></button>`;
            });
            
            if (chips) {
                chips += `<button data-clear-all class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-error/10 text-error rounded-full text-xs font-medium hover:bg-error/20 transition-colors cursor-pointer">Clear All</button>`;
                activeFiltersContainer.innerHTML = chips;
                activeFiltersContainer.classList.remove('hidden');
                
                activeFiltersContainer.querySelector('[data-clear-price]')?.addEventListener('click', () => {
                    if (filterMinPrice) filterMinPrice.value = '';
                    if (filterMaxPrice) filterMaxPrice.value = '';
                    currentPage = 1; updateDisplay();
                });
                activeFiltersContainer.querySelectorAll('[data-clear-attr]').forEach(btn => {
                    btn.addEventListener('click', () => {
                        const slug = (btn as HTMLElement).dataset.clearAttr;
                        const value = (btn as HTMLElement).dataset.clearValue;
                        const cb = document.querySelector(`[data-attr-checkbox="${slug}"][value="${value}"]`) as HTMLInputElement;
                        if (cb) cb.checked = false;
                        currentPage = 1; updateDisplay();
                    });
                });
                activeFiltersContainer.querySelector('[data-clear-all]')?.addEventListener('click', () => {
                    if (filterMinPrice) filterMinPrice.value = '';
                    if (filterMaxPrice) filterMaxPrice.value = '';
                    if (filterSale) filterSale.checked = false;
                    if (filterStock) filterStock.checked = false;
                    document.querySelectorAll('[data-attr-checkbox]:checked').forEach(cb => (cb as HTMLInputElement).checked = false);
                    currentPage = 1; updateDisplay();
                });
            } else {
                activeFiltersContainer.innerHTML = '';
                activeFiltersContainer.classList.add('hidden');
            }
        }
        
        function sortCards(cards: Element[]) {
            const sortValue = sortSelect?.value || 'date-desc';
            const [field, direction] = sortValue.split('-');
            
            return [...cards].sort((a, b) => {
                const aEl = a as HTMLElement;
                const bEl = b as HTMLElement;
                let aVal: string | number = '';
                let bVal: string | number = '';
                
                if (field === 'price') {
                    aVal = parseFloat(aEl.dataset.price || '0');
                    bVal = parseFloat(bEl.dataset.price || '0');
                } else if (field === 'name') {
                    aVal = aEl.dataset.name || '';
                    bVal = bEl.dataset.name || '';
                } else if (field === 'date') {
                    aVal = aEl.dataset.date || '';
                    bVal = bEl.dataset.date || '';
                }
                
                if (typeof aVal === 'number' && typeof bVal === 'number') {
                    return direction === 'asc' ? aVal - bVal : bVal - aVal;
                }
                return direction === 'asc' 
                    ? String(aVal).localeCompare(String(bVal)) 
                    : String(bVal).localeCompare(String(aVal));
            });
        }
        
        function updateDisplay() {
            const filtered = getFilteredCards();
            const sorted = sortCards(filtered);
            const totalPages = Math.max(1, Math.ceil(sorted.length / PRODUCTS_PER_PAGE));
            
            if (currentPage > totalPages) currentPage = totalPages;
            
            const start = (currentPage - 1) * PRODUCTS_PER_PAGE;
            const end = start + PRODUCTS_PER_PAGE;
            
            allCards.forEach(card => (card as HTMLElement).style.display = 'none');
            sorted.forEach((card, i) => {
                (card as HTMLElement).style.display = (i >= start && i < end) ? '' : 'none';
                grid.appendChild(card);
            });
            
            const visibleCount = sorted.length;
            const showStart = visibleCount > 0 ? start + 1 : 0;
            const showEnd = Math.min(end, visibleCount);
            
            if (productCount) productCount.textContent = visibleCount.toString();
            if (productCountRange && visibleCount > PRODUCTS_PER_PAGE) {
                productCountRange.textContent = `${showStart}-${showEnd} of `;
            } else if (productCountRange) {
                productCountRange.textContent = '';
            }
            
            renderPagination(totalPages);
            renderActiveFilters();
            
            const url = new URL(window.location.href);
            if (currentPage > 1) {
                url.searchParams.set('page', String(currentPage));
            } else {
                url.searchParams.delete('page');
            }
            if (filterMinPrice?.value) url.searchParams.set('min_price', filterMinPrice.value);
            else url.searchParams.delete('min_price');
            if (filterMaxPrice?.value) url.searchParams.set('max_price', filterMaxPrice.value);
            else url.searchParams.delete('max_price');
            history.replaceState(null, '', url.toString());
        }
        
        function renderPagination(totalPages: number) {
            if (!paginationControls || !pageNumbers) return;
            
            if (totalPages <= 1) {
                paginationControls.classList.add('hidden');
                return;
            }
            paginationControls.classList.remove('hidden');
            
            if (pagePrev) pagePrev.disabled = currentPage <= 1;
            if (pageNext) pageNext.disabled = currentPage >= totalPages;
            
            let html = '';
            const maxVisible = 5;
            let startPage = Math.max(1, currentPage - Math.floor(maxVisible / 2));
            let endPage = Math.min(totalPages, startPage + maxVisible - 1);
            if (endPage - startPage < maxVisible - 1) {
                startPage = Math.max(1, endPage - maxVisible + 1);
            }
            
            if (startPage > 1) {
                html += `<button data-page="1" class="w-10 h-10 rounded-lg text-sm font-medium text-content hover:bg-surface-alt border border-outline transition-colors cursor-pointer">1</button>`;
                if (startPage > 2) html += `<span class="px-1 text-content-lighter">...</span>`;
            }
            
            for (let i = startPage; i <= endPage; i++) {
                const isActive = i === currentPage;
                html += `<button data-page="${i}" class="w-10 h-10 rounded-lg text-sm font-medium transition-colors cursor-pointer ${isActive ? 'bg-primary text-white' : 'text-content hover:bg-surface-alt border border-outline'}">${i}</button>`;
            }
            
            if (endPage < totalPages) {
                if (endPage < totalPages - 1) html += `<span class="px-1 text-content-lighter">...</span>`;
                html += `<button data-page="${totalPages}" class="w-10 h-10 rounded-lg text-sm font-medium text-content hover:bg-surface-alt border border-outline transition-colors cursor-pointer">${totalPages}</button>`;
            }
            
            pageNumbers.innerHTML = html;
            pageNumbers.querySelectorAll('button[data-page]').forEach(btn => {
                btn.addEventListener('click', () => {
                    currentPage = parseInt((btn as HTMLElement).dataset.page || '1');
                    updateDisplay();
                    window.scrollTo({ top: grid.offsetTop - 100, behavior: 'smooth' });
                });
            });
        }
        
        pagePrev?.addEventListener('click', () => {
            if (currentPage > 1) { currentPage--; updateDisplay(); window.scrollTo({ top: grid.offsetTop - 100, behavior: 'smooth' }); }
        });
        pageNext?.addEventListener('click', () => {
            currentPage++; updateDisplay(); window.scrollTo({ top: grid.offsetTop - 100, behavior: 'smooth' });
        });
        
        sortSelect?.addEventListener('change', () => { currentPage = 1; updateDisplay(); });
        filterSale?.addEventListener('change', () => { currentPage = 1; updateDisplay(); });
        filterStock?.addEventListener('change', () => { currentPage = 1; updateDisplay(); });
        
        applyPriceFilter?.addEventListener('click', () => { currentPage = 1; updateDisplay(); });
        filterMinPrice?.addEventListener('keydown', (e) => { if (e.key === 'Enter') { currentPage = 1; updateDisplay(); } });
        filterMaxPrice?.addEventListener('keydown', (e) => { if (e.key === 'Enter') { currentPage = 1; updateDisplay(); } });
        
        document.querySelectorAll('[data-attr-checkbox]').forEach(cb => {
            cb.addEventListener('change', () => { currentPage = 1; updateDisplay(); });
        });
        
        document.querySelectorAll('[data-attr-toggle]').forEach(btn => {
            btn.addEventListener('click', () => {
                const slug = (btn as HTMLElement).dataset.attrToggle;
                const options = document.querySelector(`[data-attr-options="${slug}"]`);
                const chevron = document.querySelector(`[data-attr-chevron="${slug}"]`);
                options?.classList.toggle('hidden');
                chevron?.classList.toggle('rotate-180');
            });
        });
        
        const urlPage = new URL(window.location.href).searchParams.get('page');
        if (urlPage) currentPage = Math.max(1, parseInt(urlPage));
        
        const urlMinPrice = new URL(window.location.href).searchParams.get('min_price');
        const urlMaxPrice = new URL(window.location.href).searchParams.get('max_price');
        if (urlMinPrice && filterMinPrice) filterMinPrice.value = urlMinPrice;
        if (urlMaxPrice && filterMaxPrice) filterMaxPrice.value = urlMaxPrice;
        
        updateDisplay();
    });
</script>
